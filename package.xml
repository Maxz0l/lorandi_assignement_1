<?xml version="1.0"?>
<package format="3">
  <name>lorandi_assignament_1</name>
  <version>0.0.0</version>
  <description>Assignment 1 - Turtlebot navigation and perception in IASlab.</description>

  <maintainer email="enzo.lorandi@cpe.fr">Enzo Lorandi</maintainer>
  <license>Apache-2.0</license>

  <!-- Build tool -->
  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- Dépendances communes -->
  <depend>rclpy</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>apriltag_msgs</depend>

  <!-- Nœud AprilTag (fournit l'exécutable apriltag_node) -->
  <exec_depend>apriltag_ros</exec_depend>

  <!-- Pour ros2 launch -->
  <exec_depend>ros2launch</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>

